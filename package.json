{
  "name": "iceberg-river",
  "private": true,
  "version": "0.1.0",
  "description": "A low-poly 3D browser game: steer a glowing iceberg downhill and carve a flowing river to the ocean.",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-fsModuleCache",
    "test:watch": "vitest",
    "agents:demo": "vitest run src/server/live/demo.live.test.ts --no-fsModuleCache --silent=false",
    "agents:injection": "vitest run src/server/live/injection.live.test.ts --no-fsModuleCache --silent=false",
    "agents:gameplay": "node scripts/agents-live.mjs gameplay",
    "agents:story": "node scripts/agents-live.mjs story",
    "agents:report": "node scripts/agents-live.mjs report"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
