# The Last Thaw: settings for the Story Mode agent service. No real values here; never commit a real .env
# (it is git-ignored). Without any key the whole game still works and Story Mode shows the authored
# reflections and epilogue.
#
# Where the server looks (src/server/env.ts): a file named .env in the repository folder first, then the
# folder above it, then further up (at most 8 levels). For each variable the nearest file wins, and a
# variable set in the real environment wins over every file. A .env one folder above the repo works as is.
#
# Careful: an empty line such as "PORTKEY_API_KEY=" in a nearer .env still counts and hides the key in a
# farther one. If you copy this file to .env in the repo folder, fill the key in or delete its line.
# Restart `npm run dev` after changing a .env.

# ---- Keys: these two are the only keys the app reads -----------------------------------------------

# The course key (Portkey). Used for gpt-6-luna ONLY, the default model; the server refuses to send any
# other model on it (the course rule: "No other models on the course key").
PORTKEY_API_KEY=

# Optional: your own OpenAI key, used ONLY for gpt-6-sol (Settings -> Story Mode -> AI model). It is sent
# only to api.openai.com, never to Portkey, and billed to you (about 20 times the price of gpt-6-luna).
# Leave it empty and gpt-6-sol stays unavailable; gpt-6-luna is unaffected.
OPENAI_API_KEY=

# ---- Optional settings (not secrets) ---------------------------------------------------------------
# Each line below is commented out and shows the DEFAULT the server uses when the variable is unset.
# Uncomment a line only to change it.

# What gpt-6-sol may charge to your OpenAI key per UTC day, in USD. Each request first holds the most it
# could cost and is refused if that would pass the limit. 0 turns gpt-6-sol off; values above 20.00 are
# capped at 20.00; a value that is not a plain number (like "0,50") also turns it off.
# OPENAI_DAILY_USD_LIMIT=2.00

# The default model for a request that names none (the game always names the player's choice).
# Only gpt-6-luna or gpt-6-sol; anything else falls back to gpt-6-luna with a logged note.
# MODEL_NAME=gpt-6-luna

# Base URLs. Each must be https (or localhost). A URL that points one key at the other provider's host is
# refused, and the default is used instead.
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Unset by default (agents on whenever a key is present). Set to off to disable the agents even with a key.
# STORY_AI=off

# Unset by default: every request bypasses Portkey's response cache, so every logged token is a real model
# call. Set to allow to let Portkey answer repeated identical requests from its cache.
# PORTKEY_CACHE=allow
